# Copy this file to .env and fill it in. .env is gitignored and must stay that way.
#
#   cp .env.example .env
#
# Every value here is optional. With none of them set the panel runs in preview
# mode: the web interface works, the colours are shown on screen, no bulbs are
# touched and no password is needed.

# The email address you sign in to the Tapo app with.
TAPO_USERNAME=you@example.com

# Your Tapo password. Leave this blank to be asked for it at startup instead,
# which keeps it off disk entirely. That is the safer option.
TAPO_PASSWORD=

# The LAN addresses of your bulbs, comma separated. Find them in your router's
# client list or in the Tapo app under each device's settings.
TAPO_IPS=192.168.0.10,192.168.0.11

# Where the panel listens. 0.0.0.0 lets your phone reach it over the LAN;
# 127.0.0.1 keeps it to this machine only.
LAMP_HOST=0.0.0.0
LAMP_PORT=8765

# How often to re-fetch the weather, in seconds. The sun is recomputed every
# beat regardless, so there is no need to make this small.
LAMP_REFRESH_SECONDS=600

# Sent to Nominatim when reverse geocoding a map click. Their usage policy asks
# that you identify your application.
LAMP_USER_AGENT=tapo-weather-lamp (personal home lighting project)
